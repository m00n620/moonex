MONGODB_URI=""

# Optional per-chain RPC overrides: <CHAIN_ID>_RPC_URL (chain ids are the keys in src/config/chains.ts).
# Chains without an override use their public default RPC, which is rate-limited — set your own for real use.
ETHEREUM_RPC_URL=""
BASE_RPC_URL=""
BSC_RPC_URL=""
TRON_RPC_URL=""
# TronGrid API key (free at trongrid.io). Strongly recommended: without it TronGrid rate-limits requests (HTTP 429).
TRON_API_KEY=""

# Cross-chain bridging via LI.FI (https://li.fi). Both optional: the API works without a key at lower rate limits.
LIFI_API_KEY=""
LIFI_INTEGRATOR=""
